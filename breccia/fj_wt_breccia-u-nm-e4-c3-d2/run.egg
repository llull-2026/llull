;; Rules for function: unify_ExpressionWithContext_predicate

(rule
 ((unify_ExpressionWithContext_predicatecall e1 e2)
    (ExpressionWithContextTracking e1 e1_vars e1_eclasses e1_typp)
    (ExpressionWithContextTracking e2 e2_vars e2_eclasses e2_typp)
    (= e1_vars e2_vars)
    (= e1_eclasses e2_eclasses)
    (= e1_typp e2_typp)
    (ExpressionWithContextnumclassesBound e1 e1_vars e1_eclasses e1_typp e1_numclasses)
    (ExpressionWithContextnumclassesBound e2 e2_vars e2_eclasses e2_typp e1_numclasses)
    (ExpressionWithContextesizeBound e1 e1_vars e1_eclasses e1_typp e1_esize)
    (ExpressionWithContextesizeBound e2 e2_vars e2_eclasses e2_typp e1_esize))
 ((unify_ExpressionWithContext_predicate e1 e2 true)))

;; --- Unification Rules ---

(rule
 ((ExpressionWithContextTracking u_e1 t1_0 t1_1 t1_2)
    (ExpressionWithContextTracking u_e2 t2_0 t2_1 t2_2)
    (!= u_e1 u_e2))
 ((unify_ExpressionWithContext_predicatecall u_e1 u_e2)))

(rule
 ((unify_ExpressionWithContext_predicate u_e1 u_e2 true))
 ((union u_e1 u_e2)))

;; Custom Union Rules

(rule
 ((ExpressionWithContextTracking e1 tf_val1 tf_val2 tf_val3)
    (ExpressionWithContextTracking e2 tf_val1 tf_val2 tf_val3)
    (ExpressionWithContextnumclassesBound e1 tf_val1 tf_val2 tf_val3 common_b_val1)
    (ExpressionWithContextnumclassesBound e2 tf_val1 tf_val2 tf_val3 common_b_val1)
    (ExpressionWithContextesizeBound e1 tf_val1 tf_val2 tf_val3 common_b_val2)
    (ExpressionWithContextesizeBound e2 tf_val1 tf_val2 tf_val3 common_b_val2))
 ((union e1 e2)))

