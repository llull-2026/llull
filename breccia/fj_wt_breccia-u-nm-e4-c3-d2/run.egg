  )
  (Method
    (FJMethod MethodInfo Expression)
  )
  (MethodSet
    (MSNil)
    (MSCons Method MethodSet)
  )
  (ExprList
    (ENil)
    (ECons Expression ExprList)
  )
  (PartlyFilled
    (PFNil)
    (PFConsFilled Class Expression PartlyFilled)
    (PFConsEmpty Class PartlyFilled)
  )
  (Expression
    (ThisExpr Class)
    (VarExpr i64 Class)
    (CtorCallExpr Class ExprList)
    (FieldAccessExpr Expression i64)
    (MethodCallExpr Expression i64 ExprList)
  )
  (VarUsage
    (VNil)
    (VCons Class i64 VarUsage)
  )
  (ExpressionWithContext
    (EWithContext Expression MethodSet)
  )
  (PartlyFilledWithContext
    (PWithContext PartlyFilled MethodSet)
  )
)

