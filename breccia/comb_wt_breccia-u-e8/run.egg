;; Custom Union Rules

(rule
 ((TermTracking e1 tf_val1 tf_val2 tf_val3 tf_val4)
    (TermTracking e2 tf_val1 tf_val2 tf_val3 tf_val4)
    (TermesizeBound e1 tf_val1 tf_val2 tf_val3 tf_val4 common_b_val1)
