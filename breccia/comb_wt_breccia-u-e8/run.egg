;; Rules for function: maketyapp

(rule
 ((TermTracking inst inst_typ inst_freevars inst_tyvars inst_size)
    (TypeTracking t))
 ((term_sizecall inst)))

(rule
 ((TermTracking inst (Forall body) inst_freevars inst_tyvars inst_size)
